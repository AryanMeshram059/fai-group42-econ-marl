% Minimal re-creation of the arXiv/"PRIME AI paper" preprint style used for the proposal
% (layout after kourgeorge/arxiv-style, MIT licence).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/11/11 preprint style]

\RequirePackage[margin=1in,top=1in,headsep=0.25in]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{lipsum}

\newcommand{\headeright}{PRIME AI paper}
\newcommand{\undertitle}{}
\newcommand{\shorttitle}{}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\small\itshape\headeright}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}

\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \vspace*{-0.2in}%
  \hrule height 3pt\vspace{0.18in}%
  \begin{center}{\LARGE\scshape\@title\par}\end{center}%
  \vspace{0.12in}\hrule height 1pt\vspace{0.22in}%
  \begin{center}\@author\end{center}%
  \vspace{0.1in}%
}

\renewenvironment{abstract}{%
  \begin{center}{\large\scshape Abstract}\end{center}\vspace{-6pt}%
  \begin{quote}}{\end{quote}}

\newcommand{\keywords}[1]{\begin{quote}\textbf{\textit{Keywords}}\ \ #1\end{quote}}
